---
import { useTranslations } from "../i18n/utils";

const t = useTranslations(Astro.currentLocale);
---

<section class="hero">
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__glow"></div>
    <div class="hero__grid"></div>
  </div>

  <div class="container hero__content">
    <div class="hero__copy">
      <h1>{t("hero.title")}</h1>
      <p class="hero__lead">
        {t("hero.lead")}
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="#contato">{t("hero.ctaPrimary")}</a>
        <a class="btn btn--ghost" href="#solucao">{t("hero.ctaSecondary")}</a>
      </div>
    </div>

    <div class="hero__visual">
      <a
        class="hero__logo"
        href="#contato"
        aria-label={t("hero.powerLabel")}
      >
        <img
          src="/amb1-logo.svg"
          alt=""
          width="464"
          height="550"
        />
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(100svh, 56rem);
    display: flex;
    align-items: center;
    overflow: clip;
    padding-block: clamp(3rem, 8vw, 5rem) var(--space-section);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero__glow {
    position: absolute;
    inset: -10% 20% auto;
    height: 55%;
    background: radial-gradient(circle at center, rgba(184, 208, 64, 0.28), transparent 68%);
    filter: blur(8px);
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(color-mix(in srgb, var(--color-charcoal) 30%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--color-charcoal) 30%, transparent) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 85% 75% at 50% 40%, black, transparent 80%);
    opacity: 0.18;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .hero__brand {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.06em;
    color: var(--color-ink);
    line-height: 0.95;
    margin-bottom: 0.75rem;
  }

  .hero__copy h1 {
    max-width: 14ch;
    font-size: clamp(1.85rem, 4.5vw, 3rem);
    color: var(--color-charcoal);
    font-weight: 700;
  }

  .hero__lead {
    max-width: 34rem;
    margin-top: 1.25rem;
    color: var(--color-muted);
    font-size: 1.1rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .hero__visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: calc(var(--logo-h) * 1.1);
    --logo-h: min(350px, 72vw);
    --logo-scale: 1.1;
  }

  .hero__logo {
    display: block;
    height: var(--logo-h);
    width: auto;
  }

  .hero__logo img {
    display: block;
    height: 100%;
    width: auto;
    transform-origin: center bottom;
    filter: drop-shadow(0 0 0 transparent);
    transition:
      filter 0.9s var(--ease-out),
      transform 0.9s var(--ease-out);
  }

  .hero__logo:hover img {
    transform:
      translateY(calc(-50px * var(--logo-h) / 350px))
      scale(var(--logo-scale));
    filter:
      drop-shadow(0 0 18px rgba(184, 208, 64, 0.55))
      drop-shadow(0 0 42px rgba(184, 208, 64, 0.35));
  }

  .hero__logo:active img {
    transform:
      translateY(calc(-25px * var(--logo-h) / 350px))
      scale(calc(var(--logo-scale) * 0.98));
  }

  .hero__logo:focus-visible {
    outline: 3px solid var(--color-lime);
    outline-offset: 6px;
    border-radius: var(--radius);
  }

  @media (min-width: 900px) {
    .hero__content {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 3rem;
    }

    .hero__visual {
      --logo-h: 350px;
      justify-self: end;
    }
  }
</style>
